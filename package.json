{
  "name": "no-service-even-g2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "node --no-warnings --experimental-transform-types --test harness/*.test.mjs src/*/*.test.ts",
    "fitness": "node harness/fitness.mjs",
    "fitness:badge": "node scripts/write-fitness-badge.mjs",
    "fitness:implementation": "node harness/fitness.mjs --phase implementation",
    "fitness:release": "node harness/fitness.mjs --phase release",
    "narrative:prepare": "node scripts/prepare-narrative-review.mjs",
    "narrative:verify": "node scripts/verify-narrative-review.mjs",
    "loop:check:narrative": "npm run narrative:verify && npm run loop:check",
    "loop:check": "npm test && npm run fitness && npm run build",
    "loop:check:implementation": "npm test && npm run fitness:implementation && npm run build",
    "loop:check:release": "npm test && npm run fitness:release && npm run build",
    "pack": "npm run build && evenhub pack app.json dist -o no-service.ehpk",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "simulator": "evenhub-simulator",
    "simulator:evidence": "npm run build && node scripts/verify-simulator.mjs",
    "qr": "evenhub qr --http --port 5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
