{
  "name": "even-g2-hardware-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "node --test harness/*.test.mjs",
    "fitness": "node harness/fitness.mjs",
    "fitness:implementation": "node harness/fitness.mjs --phase implementation",
    "fitness:release": "node harness/fitness.mjs --phase release",
    "loop:check": "npm test && npm run fitness && npm run build",
    "loop:check:implementation": "npm test && npm run fitness:implementation && npm run build",
    "loop:check:release": "npm test && npm run fitness:release && npm run build",
    "pack": "npm run build && evenhub pack app.json dist -o g2-hardware-lab.ehpk",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "simulator": "evenhub-simulator",
    "qr": "evenhub qr --http --port 5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
